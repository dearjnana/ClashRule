# 保持现有后台路径；首次部署时替换为自己生成的随机路径。
SUB_STORE_FRONTEND_BACKEND_PATH=/replace-with-random-path
# 仅允许实际使用的前端地址；注意协议和端口必须完全一致。
SUB_STORE_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3001
# 每日定时同步；沿用现有任务时使用新版变量名称。
SUB_STORE_BACKEND_SYNC_CRON=55 23 * * *
SUB_STORE_BACKEND_API_HOST=127.0.0.1
SUB_STORE_FRONTEND_HOST=0.0.0.0
TZ=Asia/Shanghai
TIME_ZONE=Asia/Shanghai
NODE_OPTIONS=--max-old-space-size=768
