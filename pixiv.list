# ==========================================
# Pixiv Android 客户端依赖 SDK 域名
# (防止 BanAD 误杀导致初始化死锁/卡图)
# 【重要】本文件必须排在 INI 中 BanProgramAD 之前才会生效!
#         V4.1 的 INI 已将本文件前置到广告列表之前。
# ==========================================
# --- AppLovin 架构 (BanAD 已屏蔽 applovin.com) ---
DOMAIN-SUFFIX,applovin.com
DOMAIN-SUFFIX,applvn.com

# --- Appier 架构 ---
DOMAIN-SUFFIX,appier.net
DOMAIN-SUFFIX,adsappier.com
DOMAIN-SUFFIX,appiersig.com

# --- InMobi 架构 ---
DOMAIN-SUFFIX,inmobi.com
DOMAIN-SUFFIX,inmobicdn.net

# --- Pangle (字节海外广告) ---
DOMAIN-SUFFIX,pangle.io

# --- Inner-Active / Rubicon 聚合架构 ---
DOMAIN-SUFFIX,inner-active.mobi
DOMAIN-SUFFIX,rubiconproject.com

# --- Unity Ads (AppLovin 聚合会调用; BanAD 屏蔽了 adserver.unityads.unity3d.com) ---
DOMAIN-SUFFIX,unityads.unity3d.com
